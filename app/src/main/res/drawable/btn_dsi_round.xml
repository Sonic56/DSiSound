<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#1A44AA" />
            <stroke android:width="2dp" android:color="#88AADD" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#6699CC"
                android:centerColor="#4477BB"
                android:endColor="#2255AA"
                android:angle="270" />
            <stroke android:width="2dp" android:color="#AACCFF" />
        </shape>
    </item>
</selector>

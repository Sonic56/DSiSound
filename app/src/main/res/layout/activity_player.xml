<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A2A4A">

    <!-- ══════════════════════════════════════ -->
    <!-- TOP SCREEN — visualizer               -->
    <!-- ══════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/topScreen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <com.dsi.sound.VisualizerView
            android:id="@+id/visualizerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.dsi.sound.MarioVisualizerView
            android:id="@+id/marioView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.dsi.sound.ChickView
            android:id="@+id/chickView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Waveform bars at bottom of top screen -->
        <com.dsi.sound.WaveformView
            android:id="@+id/waveformView"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom" />

        <!-- Song title ticker top of screen -->
        <TextView
            android:id="@+id/topSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#99000000"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:focusable="true"
            android:text="DSi Sound" />

    </FrameLayout>

    <!-- Screen bezel gap -->
    <View
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:background="#0D1A30" />

    <!-- ══════════════════════════════════════ -->
    <!-- BOTTOM SCREEN — controls              -->
    <!-- DSi-accurate light blue layout        -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#C8DFF0"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- Row 1: Song name -->
        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#223355"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Song Title" />

        <!-- Row 2: Artist name -->
        <TextView
            android:id="@+id/artistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#446688"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp"
            android:text="Artist" />

        <!-- Row 3: Seek bar + times -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:textColor="#223355"
                android:textSize="10sp"
                android:text="0:00" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressDrawable="@drawable/seekbar_progress"
                android:max="1000" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:textColor="#223355"
                android:textSize="10sp"
                android:gravity="end"
                android:text="0:00" />
        </LinearLayout>

        <!-- Row 4: Main playback buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <ImageButton
                android:id="@+id/prevBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/btn_dsi_round"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF"
                android:contentDescription="Previous"
                android:layout_marginRight="8dp" />

            <ImageButton
                android:id="@+id/playPauseBtn"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/btn_play_bg"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFF"
                android:contentDescription="Play"
                android:layout_marginRight="8dp" />

            <ImageButton
                android:id="@+id/nextBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/btn_dsi_round"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFFF"
                android:contentDescription="Next" />

        </LinearLayout>

        <!-- Row 5: Pitch + Speed 2D pad area (like real DSi) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <!-- 2D touch pad for pitch/speed -->
            <com.dsi.sound.PitchSpeedPad
                android:id="@+id/pitchSpeedPad"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginRight="8dp" />

            <!-- Labels + values column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed"
                    android:textColor="#223355"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/speedValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textColor="#4466AA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pitch"
                    android:textColor="#223355"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pitchValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textColor="#4466AA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 6: Bottom nav bar (Back | Viz tabs | Viz cycle) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_dsi_round"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#FFFFFF"
                android:contentDescription="Back" />

            <!-- Scrollable viz tabs -->
            <HorizontalScrollView
                android:id="@+id/vizTabsRow"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp">

                <LinearLayout
                    android:id="@+id/vizTabsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </HorizontalScrollView>

            <!-- Viz cycle button with parakeet -->
            <ImageButton
                android:id="@+id/vizToggleBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_dsi_round"
                android:src="@drawable/parakeet"
                android:scaleType="fitCenter"
                android:contentDescription="Change visualizer"
                android:padding="4dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
